# DeepVisor environment template
# Copy this file to .env.local for local Next.js development.

# App URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Internal API auth
# Use the same value in the Next.js app and Supabase Edge Function secrets.
INTERNAL_API_KEY=replace-with-a-long-random-secret

# Meta OAuth and Graph API
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# Optional: use a Meta business login configuration instead of explicit scopes.
META_BUSINESS_CONFIG_ID=
# Optional: set to 1 to log Meta Graph API request pagination/debug metadata.
META_GRAPH_DEBUG=0

# Google Ads OAuth and API
# app: use this deployment's Google Ads credentials for every workspace.
# workspace: require each workspace owner/admin to enter their own credentials before connecting.
GOOGLE_ADS_CREDENTIAL_MODE=app
GOOGLE_ADS_CLIENT_ID=your-google-oauth-client-id
GOOGLE_ADS_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_ADS_DEVELOPER_TOKEN=your-google-ads-developer-token
# Optional: manager account/MCC customer ID without dashes, if requests should be scoped through one.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional: defaults to https://www.googleapis.com/auth/adwords when unset.
GOOGLE_ADS_SCOPES=https://www.googleapis.com/auth/adwords

# OpenAI
OPENAI_API_KEY=your-openai-api-key
# Optional model overrides. Defaults are defined in src/lib/server/openai/config.ts.
OPENAI_MODEL=
OPENAI_FAST_MODEL=
OPENAI_QUEUE_MODEL=
OPENAI_STRUCTURED_TIMEOUT_MS=8000

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PRICE_ID_TIER1=price_replace_tier1
STRIPE_PRICE_ID_TIER2=price_replace_tier2
STRIPE_PRICE_ID_TIER3=price_replace_tier3

# Reports
# Optional: defaults to report-archive-pdfs when unset.
REPORT_ARCHIVE_BUCKET=report-archive-pdfs

# Supabase Edge Functions
# Set these as Supabase function secrets for deployed edge functions.
# APP_BASE_URL is preferred; SITE_URL is accepted as a fallback by the functions.
APP_BASE_URL=https://your-app.example.com
SITE_URL=
CRON_SECRET=replace-with-a-long-random-cron-secret
# Local-only bypass flags. Leave false/empty in deployed environments.
SKIP_CRON_SECRET=false
ALLOW_LOCALHOST_APP_BASE_URL=false

# Optional Supabase CLI/config placeholders
# Used only if the corresponding Supabase config feature is enabled.
SENDGRID_API_KEY=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
S3_HOST=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
